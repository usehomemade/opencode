{
  "$schema": "https://homemade.dev/schemas/config.json",
  "size": "small",
  "warmup": [
    "bun install --frozen-lockfile"
  ],
  "install": [
    "bun install --frozen-lockfile"
  ],
  "services": {
    "web": {
      "displayName": "OpenCode",
      "cmd": "cd packages/opencode && exec bun --watch --no-clear-screen --watch-kill-signal SIGKILL src/index.ts serve --port \"$PORT\" --hostname 0.0.0.0",
      "port": 4096,
      "url": true,
      "share": "owner",
      "healthcheck": {
        "path": "/"
      }
    }
  },
  "env_schema": []
}
