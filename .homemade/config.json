{
  "$schema": "https://homemade.dev/schemas/config.json",
  "size": "small",
  "warmup": [
    "bun install --frozen-lockfile"
  ],
  "install": [
    "bun install --frozen-lockfile"
  ],
  "services": {
    "web": {
      "displayName": "OpenCode",
      "cmd": "exec bun dev serve --port 4096 --hostname 0.0.0.0",
      "port": 4096,
      "url": true,
      "share": "owner",
      "healthcheck": {
        "path": "/"
      }
    }
  }
}